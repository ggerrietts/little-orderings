# Copy to .env on the server (chmod 600), fill in real values.
# Never commit the real .env — it's gitignored.
# Used by docker-compose.prod.yml via env_file.

# Generate with: openssl rand -base64 32
SESSION_SECRET=

# Created once by the init-user service on first `docker compose up`.
# Change the password via the `user set-password` CLI afterward if you want
# to rotate it without touching this file.
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
